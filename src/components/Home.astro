---
import type { Locale } from "../data/catalog";
import { groups, localizedGroup, localizedTool, tools } from "../data/catalog";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const isEnglish = locale === "en";
const labels = isEnglish
    ? {
        eyebrow: "ZKTOOL / LOCAL-FIRST TOOLS",
        title: "Leave the complexity to the tools.",
        intro: "A quiet, local-first toolkit for formatting, debugging, converting, and testing.",
        searchPlaceholder: "Search tools by name, format, or keyword",
        searchLabel: "Search all tools",
        available: "tools available",
        result: "matching tools",
        clear: "Clear search",
        emptyTitle: "No tools found",
        emptyText: "Try a different name, format, or keyword.",
        local: "Runs locally",
        privacy: "No account required",
        open: "Open tool",
        external: "External service",
        browse: "All tools",
    }
    : {
        eyebrow: "ZKTOOL / LOCAL-FIRST TOOLS",
        title: "把复杂，留给工具。",
        intro: "一组本地运行的实用工具，覆盖格式化、调试、转换与测试。",
        searchPlaceholder: "搜索工具名称、格式或关键词",
        searchLabel: "搜索全部工具",
        available: "个工具可用",
        result: "个匹配工具",
        clear: "清空搜索",
        emptyTitle: "没有找到相关工具",
        emptyText: "换一个名称、格式或关键词试试。",
        local: "浏览器本地运行",
        privacy: "无需登录",
        open: "打开工具",
        external: "外部服务",
        browse: "全部工具",
    };
const totalTools = tools.length;
const homePath = isEnglish ? "/en/" : "/";
---
<main class="home" data-home data-result-label={labels.result}>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-inner">
      <div class="hero-topline">
        <p class="eyebrow">{labels.eyebrow}</p>
        <span class="hero-note"><span class="status-dot" aria-hidden="true"></span>{labels.local}</span>
      </div>
      <div class="hero-copy">
        <h1 id="home-title">{isEnglish ? labels.title : <><span>把复杂，留给</span><span class="title-tail">工具。</span></>}</h1>
        <p class="hero-intro">{labels.intro}</p>
      </div>
      <div class="search-shell">
        <div class="search-wrap">
          <label class="sr-only" for="tool-search">{labels.searchLabel}</label>
          <span class="search-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
          </span>
          <input id="tool-search" data-tool-search type="search" autocomplete="off" aria-controls="tool-results" aria-describedby="search-help" placeholder={labels.searchPlaceholder} />
          <button type="button" class="search-clear" data-search-clear aria-label={labels.clear} hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
          </button>
        </div>
        <span class="search-hint" id="search-help">{isEnglish ? "/ to search · ↓ results" : "/ 搜索 · ↓ 选择结果"}</span>
      </div>
      <div class="hero-meta">
        <span><strong data-tool-count>{totalTools}</strong> {labels.available}</span>
        <span class="meta-separator" aria-hidden="true">/</span>
        <span>{labels.privacy}</span>
        <a class="browse-link" href="#tools">{labels.browse}<span aria-hidden="true">&#8595;</span></a>
      </div>
    </div>
  </section>

  <nav class="group-nav" aria-label={labels.browse}>
    {groups.map((group) => {
      const hasEntries = tools.some((tool) => (tool.type === "tool" || tool.type === "external") && tool.group === group.key);
      if (!hasEntries) return null;
      return <a href={`#group-${group.key}`}>{localizedGroup(group, locale).title}</a>;
    })}
  </nav>

  <div class="collection-head" id="tools">
    <h2>{labels.browse}</h2>
    <span class="result-count" data-result-count role="status" aria-live="polite" aria-atomic="true">{totalTools} {labels.available}</span>
  </div>

  <div class="tool-collection" id="tool-results">
    {groups.map((group) => {
      const entries = tools.filter((tool) => (tool.type === "tool" || tool.type === "external") && tool.group === group.key);
      if (!entries.length) return null;
      const localized = localizedGroup(group, locale);
      return <section class="tool-group" id={`group-${group.key}`} data-tool-group aria-labelledby={`group-title-${group.key}`}>
        <div class="group-heading">
          <h3 id={`group-title-${group.key}`}>{localized.title}</h3>
          <span>{entries.length.toString().padStart(2, "0")}</span>
        </div>
        <div class="tool-grid">
          {entries.map((source) => {
            const tool = localizedTool(source, locale);
            const external = tool.path.startsWith("http");
            const href = external ? tool.path : `${homePath}${tool.path}`;
            const searchText = `${tool.name} ${tool.desc} ${tool.tag} ${tool.kw}`.toLowerCase();
            return <a
              class="tool-card"
              href={href}
              data-tool-card
              data-search={searchText}
              data-external={external ? "true" : undefined}
              target={external ? "_blank" : undefined}
              rel={external ? "noopener noreferrer" : undefined}
            >
              <span class="tool-icon" style={`--start:${tool.c1};--end:${tool.c2}`} set:html={tool.icon} />
              <span class="tool-copy">
                <span class="tool-card-top"><b>{tool.name}</b><span class="tool-arrow" aria-hidden="true">&#8599;</span></span>
                <small>{tool.desc}</small>
                <span class="tool-tag">{external ? labels.external : tool.tag}</span>
              </span>
              <span class="sr-only">{labels.open}</span>
            </a>;
          })}
        </div>
      </section>;
    })}
  </div>

  <section class="search-empty" data-search-empty hidden>
    <span class="empty-mark" aria-hidden="true">?</span>
    <h2>{labels.emptyTitle}</h2>
    <p>{labels.emptyText}</p>
  </section>
</main>

<script>
  const home = document.querySelector("[data-home]");
  const search = home?.querySelector<HTMLInputElement>("[data-tool-search]");
  const clear = home?.querySelector<HTMLButtonElement>("[data-search-clear]");
  const count = home?.querySelector<HTMLElement>("[data-result-count]");
  const empty = home?.querySelector<HTMLElement>("[data-search-empty]");
  const cards = home ? Array.from(home.querySelectorAll<HTMLAnchorElement>("[data-tool-card]")) : [];
  const groups = home ? Array.from(home.querySelectorAll<HTMLElement>("[data-tool-group]")) : [];
  const availableLabel = {available: home?.querySelector(".result-count")?.textContent?.replace(/^\d+\s*/, "") || ""};
  const resultLabel = home?.getAttribute("data-result-label") || "";

  function filterTools() {
    const query = search?.value.trim().toLowerCase() || "";
    const terms: string[] = query.split(/\s+/).filter(Boolean);
    home?.classList.toggle("is-searching", !!query);
    let visible = 0;
    cards.forEach((card) => {
      const haystack = card.getAttribute("data-search") || "";
      const matches = terms.every((term) => haystack.includes(term));
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    groups.forEach((group) => {
      group.hidden = !group.querySelector("[data-tool-card]:not([hidden])");
      const badge = group.querySelector(".group-heading > span");
      if (badge) badge.textContent = String(group.querySelectorAll("[data-tool-card]:not([hidden])").length).padStart(2, "0");
      const link = home?.querySelector<HTMLAnchorElement>(`.group-nav a[href="#${group.id}"]`);
      if (link) link.hidden = group.hidden;
    });
    if (count) count.textContent = query ? `${visible} ${resultLabel}` : `${cards.length} ${availableLabel.available}`;
    if (empty) empty.hidden = visible > 0;
    if (clear) clear.hidden = !query;
  }

  search?.addEventListener("input", filterTools);
  search?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowDown" || (event.key === "Enter" && search.value.trim())) {
      const first = cards.find((card) => !card.hidden);
      if (first) { event.preventDefault(); first.focus(); }
    }
    if (event.key === "Escape") { search.value = ""; filterTools(); }
  });
  home?.querySelector(".tool-collection")?.addEventListener("keydown", (rawEvent) => {
    const event = rawEvent as KeyboardEvent;
    const visible = cards.filter((card) => !card.hidden);
    const index = visible.indexOf(document.activeElement as HTMLAnchorElement);
    if (index < 0) return;
    if (event.key === "Escape" || (event.key === "ArrowUp" && index === 0)) {
      event.preventDefault(); search?.focus();
    } else if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      event.preventDefault(); visible[index + (event.key === "ArrowDown" ? 1 : -1)]?.focus();
    }
  });
  clear?.addEventListener("click", () => { if (search) { search.value = ""; search.focus(); filterTools(); } });
  window.addEventListener("keydown", (event) => {
    const target = event.target as HTMLElement | null;
    const typing = target?.tagName === "INPUT" || target?.tagName === "TEXTAREA" || target?.isContentEditable;
    if ((event.key === "/" && !typing) || ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k")) {
      event.preventDefault();
      search?.focus();
    }
  });
</script>

<style>
  :global(body) { background: var(--bg); }
  .home { width: min(1180px, calc(100% - 2.5rem)); margin: 0 auto 5.5rem; color: var(--text); }
  .home-hero { width: 100vw; margin-left: calc(50% - 50vw); overflow: hidden; background: var(--bg-soft); color: var(--text); }
  .home-hero::before { display: block; height: 1px; background: var(--border); content: ""; }
  .hero-inner { position: relative; width: min(1180px, calc(100% - 2.5rem)); margin: 0 auto; padding: clamp(2rem, 4vw, 3.5rem) 0 2rem; }
  .hero-inner::before { position: absolute; top: 0; right: -12rem; width: 32rem; height: 32rem; border: 1px solid var(--border); border-radius: 50%; content: ""; opacity: .7; pointer-events: none; }
  .hero-topline, .hero-copy, .search-shell, .hero-meta { position: relative; z-index: 1; }
  .hero-topline { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .eyebrow { margin: 0 0 1.25rem; color: var(--text-2); font-size: .68rem; font-weight: 750; letter-spacing: .15em; }
  .hero-note { display: inline-flex; align-items: center; gap: .45rem; margin-bottom: 1.25rem; color: var(--text-2); font-size: .72rem; }
  .status-dot { width: .42rem; height: .42rem; border-radius: 50%; background: #37b581; box-shadow: var(--shadow-sm); }
  h1 { max-width: 48rem; margin: 0; color: var(--text); font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 650; letter-spacing: -.025em; line-height: 1.03; }
  .title-tail { white-space: nowrap; color: var(--text-2); }
  .hero-intro { max-width: 36rem; margin: 1.25rem 0 2.15rem; color: var(--text-2); font-size: 1rem; line-height: 1.75; }
  .search-shell { max-width: 49rem; padding: .55rem; border: 1px solid var(--border); border-radius: 11px; background: var(--bg-soft); box-shadow: var(--shadow-sm); }
  .search-wrap { position: relative; display: flex; align-items: center; }
  .search-wrap input { width: 100%; height: 3.75rem; padding: 0 3.5rem 0 3.35rem; border: 1px solid var(--border); border-radius: 7px; outline: none; background: var(--surface); color: var(--text); font: inherit; font-size: .98rem; box-shadow: var(--shadow-sm); transition: border-color .18s, box-shadow .18s, background .18s; }
  .search-wrap input:focus { border-color: var(--border-hover); background: var(--surface); box-shadow: var(--shadow-sm); }
  .search-wrap input::placeholder { color: var(--text-2); }
  .search-icon { position: absolute; left: 1.15rem; z-index: 1; display: grid; color: var(--text-2); pointer-events: none; }
  .search-icon svg, .search-clear svg { width: 1.1rem; height: 1.1rem; }
  .search-clear { position: absolute; right: .75rem; display: grid; width: 2rem; height: 2rem; place-items: center; border: 0; border-radius: 5px; background: transparent; color: var(--text-2); cursor: pointer; }
  .search-clear:hover, .search-clear:focus-visible { color: var(--text); background: var(--surface-2); outline: none; }
  .search-hint { display: block; margin: .6rem .4rem .1rem; color: var(--text-2); font-size: .75rem; }
  .hero-meta { display: flex; align-items: center; flex-wrap: wrap; gap: .75rem; margin-top: 1.35rem; color: var(--text-2); font-size: .74rem; }
  .hero-meta strong { color: var(--text); font-weight: 700; }
  .meta-separator { color: var(--border); }
  .browse-link { display: inline-flex; align-items: center; gap: .45rem; margin-left: .25rem; color: var(--text); font-size: .74rem; font-weight: 700; text-decoration: none; }
  .browse-link:hover { color: var(--brand); }
  .browse-link span { font-size: .95rem; }
  .group-nav { display: flex; gap: .2rem; overflow-x: auto; margin-top: 1.35rem; padding: .42rem; border: 1px solid var(--border); border-radius: 8px; background: var(--bg-soft); box-shadow: var(--shadow-sm); scrollbar-width: none; }
  .group-nav::-webkit-scrollbar { display: none; }
  .group-nav a { flex: 0 0 auto; padding: .58rem .75rem; border: 1px solid transparent; border-radius: 5px; color: var(--text-2); font-size: .76rem; text-decoration: none; transition: border-color .16s, color .16s, background .16s, box-shadow .16s; }
  .group-nav a:hover, .group-nav a:focus-visible { border-color: var(--border); background: var(--surface); color: var(--text); box-shadow: var(--shadow-sm); outline: none; }
  .collection-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 1.75rem 0 .25rem; }
  .collection-head h2 { margin: 0; color: var(--text); font-size: 1.35rem; font-weight: 720; letter-spacing: -.01em; }
  .result-count { padding: .3rem .5rem; border: 1px solid var(--border); border-radius: 5px; background: var(--bg-soft); color: var(--text-2); font-size: .7rem; box-shadow: var(--shadow-sm); }
  .tool-group { margin-top: 1.5rem; scroll-margin-top: 1.25rem; }
  .group-heading { display: flex; align-items: center; gap: .65rem; margin-bottom: 1rem; }
  .group-heading::after { height: 1px; flex: 1; background: var(--border); content: ""; }
  .group-heading h3 { margin: 0; color: var(--text-2); font-size: .84rem; font-weight: 750; }
  .group-heading span { color: var(--text-2); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .66rem; }
  .tool-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .8rem; }
  .tool-card { display: grid; grid-template-columns: 2.3rem minmax(0, 1fr); gap: .78rem; min-width: 0; min-height: 8.7rem; padding: .95rem; border: 1px solid var(--border); border-radius: 7px; background: var(--surface); color: var(--text); text-decoration: none; box-shadow: var(--shadow-sm); transition: border-color .18s, background .18s, box-shadow .18s, transform .18s; }
  .tool-card:hover, .tool-card:focus-visible { border-color: var(--border-hover); background: var(--surface); box-shadow: var(--shadow-sm); transform: translateY(-2px); outline: none; }
  .tool-icon { display: grid; width: 2.3rem; height: 2.3rem; place-items: center; border: 1px solid rgba(255, 255, 255, .45); border-radius: 6px; background: linear-gradient(135deg, var(--start), var(--end)); color: #fff; box-shadow: var(--shadow-sm); }
  .tool-icon :global(svg) { width: 1.12rem; height: 1.12rem; }
  .tool-copy { display: flex; min-width: 0; flex-direction: column; }
  .tool-card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: .5rem; }
  .tool-card-top b { color: var(--text); font-size: .95rem; font-weight: 700; line-height: 1.35; }
  .tool-arrow { flex: none; color: var(--text-2); font-size: .88rem; line-height: 1.1; transition: color .18s, transform .18s; }
  .tool-card:hover .tool-arrow, .tool-card:focus-visible .tool-arrow { color: var(--text); transform: translate(1px, -1px); }
  .tool-copy small { display: -webkit-box; margin-top: .35rem; overflow: hidden; color: var(--text-2); font-size: .85rem; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .tool-tag { align-self: flex-start; margin-top: .65rem; padding: .3rem .42rem; border: 1px solid var(--border); border-radius: 4px; background: var(--surface-2); color: var(--text-2); font-size: .75rem; line-height: 1; }
  .search-empty { padding: 4.5rem 1rem; text-align: center; border-top: 1px solid var(--border); }
  .empty-mark { display: inline-grid; width: 2.4rem; height: 2.4rem; place-items: center; border: 1px solid var(--border); border-radius: 50%; color: var(--text-2); font-weight: 700; }
  .search-empty h2 { margin: 1rem 0 .35rem; color: var(--text); font-size: 1rem; }
  .search-empty p { margin: 0; color: var(--text-2); font-size: .84rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .home [hidden] { display: none !important; }
  @media (max-width: 1000px) { .tool-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .home { width: min(100% - 2rem, 42rem); } .hero-inner { width: min(100% - 2rem, 42rem); padding: 2.5rem 0 1.75rem; } .group-nav { width: calc(100% + 1rem); margin-left: -.5rem; } .tool-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .hero-inner::before { right: -18rem; } }
  @media (max-width: 520px) { .home { width: min(100% - 1.25rem, 42rem); } .hero-inner { width: min(100% - 1.25rem, 42rem); padding: 2rem 0 1.5rem; } .hero-topline { align-items: flex-start; flex-direction: column; gap: 0; } .hero-note { margin-top: -.65rem; } h1 { font-size: clamp(2.65rem, 12vw, 3.5rem); } .hero-intro { margin-bottom: 1.7rem; font-size: .92rem; } .search-wrap input { height: 3.55rem; padding-right: 3.5rem; } .search-hint { display: none; } .hero-meta { gap: .5rem; } .browse-link { margin-left: 0; width: 100%; } .tool-grid { grid-template-columns: 1fr; } .tool-card { min-height: 7.8rem; } .collection-head { align-items: flex-start; flex-direction: column; gap: .3rem; } }
  @media (prefers-reduced-motion: reduce) { .tool-card, .tool-arrow, .search-wrap input { transition: none; } }
  .search-wrap input::-webkit-search-cancel-button { display: none; }
  .tool-card:focus-visible, .group-nav a:focus-visible, .search-clear:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; }
  .search-wrap input:focus { outline: 2px solid var(--brand); outline-offset: 2px; }
  .is-searching .hero-meta, .is-searching .group-nav { display: none; }
  .is-searching .hero-inner { padding-bottom: 1.2rem; }
  .tool-copy small { -webkit-line-clamp: 3; }
  @media (max-width: 520px) { .search-hint { display: block; } .hero-note { display: none; } h1 { font-size: 2.5rem; } .hero-intro { margin: 1rem 0; } .tool-card { min-height: 7rem; padding: 1rem; } }
</style>

---
import type { Locale } from "../data/catalog";
import { groups, localizedGroup, localizedTool, tools } from "../data/catalog";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const isEnglish = locale === "en";
const labels = isEnglish
    ? {
        titleLead: "Browser-based ",
        titleTail: "developer tools",
        intro: "Leave the complexity to the tools. Format data, debug code, and convert values in your browser.",
        searchPlaceholder: "Search tools by name, format, or keyword…",
        searchLabel: "Search all tools",
        available: "tools ready",
        result: "matching tools",
        clear: "Clear search",
        emptyTitle: "No tools found",
        emptyText: "Try a different name, format, or keyword.",
        local: "Runs 100% locally",
        privacy: "No sign-in required",
        open: "Open tool",
        external: "External",
        browse: "All tools",
        tasks: "Common tasks",
        recentDock: "Recent",
    }
    : {
        titleLead: "开发者",
        titleTail: "在线工具箱",
        intro: "把复杂，留给工具。在浏览器里格式化数据、调试代码、转换时间与编码。",
        searchPlaceholder: "搜索工具名称、格式或拼音缩写（如 json / mgdz）…",
        searchLabel: "搜索全部工具",
        available: "个工具就绪",
        result: "个匹配工具",
        clear: "清空搜索",
        emptyTitle: "没有找到相关工具",
        emptyText: "换一个名称、格式或关键词试试。",
        local: "浏览器本地运行",
        privacy: "无需登录",
        open: "打开工具",
        external: "外部服务",
        browse: "全部工具",
        tasks: "常见任务",
        recentDock: "最近使用",
    };
const totalTools = tools.length;
const homePath = isEnglish ? "/en/" : "/";
const tasks = [
    { slug: "docker-compose-converter", "zh-CN": "把 docker run 命令转成 Compose", en: "Convert docker run to Compose" },
    { slug: "hash-tool", "zh-CN": "排查 SHA-256 校验值不一致", en: "Troubleshoot a SHA-256 mismatch" },
    { slug: "timestamp-converter", "zh-CN": "判断时间戳是秒还是毫秒", en: "Identify seconds vs. milliseconds" },
];
---
<main
  class="home"
  data-home
  data-result-label={labels.result}
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-mesh" aria-hidden="true"></div>
    <div class="hero-inner">
      <div class="hero-topline">
        <span class="hero-pill">
          <span class="status-dot" aria-hidden="true"></span>
          {labels.local} · {labels.privacy}
        </span>
        <span class="hero-count"><strong data-tool-count>{totalTools}</strong> {labels.available}</span>
      </div>

      <div class="hero-copy">
        <h1 id="home-title">
          <span>{labels.titleLead}</span><span class="title-tail">{labels.titleTail}</span>
        </h1>
        <p class="hero-intro">{labels.intro}</p>
      </div>

      <div class="search-shell">
        <div class="search-wrap">
          <label class="sr-only" for="tool-search">{labels.searchLabel}</label>
          <span class="search-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
          </span>
          <input id="tool-search" data-tool-search type="search" autocomplete="off" aria-controls="tool-results" aria-describedby="search-help" placeholder={labels.searchPlaceholder} />
          <kbd class="search-kbd" data-search-kbd aria-hidden="true">/</kbd>
          <button type="button" class="search-clear" data-search-clear aria-label={labels.clear} hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
          </button>
        </div>
        <span class="sr-only" id="search-help">{isEnglish ? "Press slash to search and Down arrow to browse results" : "按 / 搜索，按方向键选择结果"}</span>
      </div>

      <nav class="dock-bar" aria-label={labels.tasks}>
        <span class="dock-label" aria-hidden="true">{labels.tasks}</span>
        <div class="dock-items">
          {tasks.map(task => (
            <a class="dock-pill task-link" href={`${homePath}tools/${task.slug}/`}>
              {task[locale]} <span aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </nav>
      <div class="dock-bar" data-dock-bar hidden>
        <span class="dock-label">{labels.recentDock}</span>
        <div class="dock-items" data-dock-items></div>
      </div>
    </div>
  </section>

  <nav class="group-nav mobile-group-nav" aria-label={labels.browse}>
    {groups.map((group) => {
      const hasEntries = tools.some((tool) => (tool.type === "tool" || tool.type === "external") && tool.group === group.key);
      if (!hasEntries) return null;
      return <a href={`#group-${group.key}`} data-group-link={`group-${group.key}`}>{localizedGroup(group, locale).title}</a>;
    })}
  </nav>

  <div class="collection-head" id="tools">
    <h2>{labels.browse}</h2>
    <span class="result-count" data-result-count role="status" aria-live="polite" aria-atomic="true">{totalTools} {labels.available}</span>
  </div>

  <div class="tool-collection" id="tool-results">
    {groups.map((group) => {
      const entries = tools.filter((tool) => (tool.type === "tool" || tool.type === "external") && tool.group === group.key);
      if (!entries.length) return null;
      const localized = localizedGroup(group, locale);
      return <section class="tool-group" id={`group-${group.key}`} data-tool-group aria-labelledby={`group-title-${group.key}`}>
        <div class="group-heading">
          <h3 id={`group-title-${group.key}`}>{localized.title}</h3>
          <span class="group-count">{entries.length.toString().padStart(2, "0")}</span>
        </div>
        <div class="tool-grid">
          {entries.map((source) => {
            const tool = localizedTool(source, locale);
            const external = tool.path.startsWith("http");
            const href = external ? tool.path : `${homePath}${tool.path}`;
            const searchText = `${tool.name} ${tool.desc} ${tool.tag} ${tool.kw}`.toLowerCase();
            return <a
              class="tool-card"
              href={href}
              data-tool-card
              data-tool-path={source.path}
              data-tool-name={tool.name}
              data-tool-color={tool.c1}
              data-search={searchText}
              data-external={external ? "true" : undefined}
              target={external ? "_blank" : undefined}
              rel={external ? "noopener noreferrer" : undefined}
            >
              <span class="tool-icon" style={`--start:${tool.c1};--end:${tool.c2}`} set:html={tool.icon} />
              <span class="tool-copy">
                <span class="tool-card-top"><b>{tool.name}</b><span class="tool-arrow" aria-hidden="true">&#8599;</span></span>
                <small>{tool.desc}</small>
                <span class="tool-tag">{external ? labels.external : tool.tag}</span>
              </span>
              <span class="sr-only">{labels.open}</span>
            </a>;
          })}
        </div>
      </section>;
    })}
  </div>

  <section class="search-empty" data-search-empty hidden>
    <span class="empty-mark" aria-hidden="true">?</span>
    <h2>{labels.emptyTitle}</h2>
    <p>{labels.emptyText}</p>
  </section>
</main>

<script>
  const home = document.querySelector<HTMLElement>("[data-home]");
  const search = home?.querySelector<HTMLInputElement>("[data-tool-search]");
  const clear = home?.querySelector<HTMLButtonElement>("[data-search-clear]");
  const kbd = home?.querySelector<HTMLElement>("[data-search-kbd]");
  const count = home?.querySelector<HTMLElement>("[data-result-count]");
  const empty = home?.querySelector<HTMLElement>("[data-search-empty]");
  const dockBar = home?.querySelector<HTMLElement>("[data-dock-bar]");
  const dockItems = home?.querySelector<HTMLElement>("[data-dock-items]");
  const cards = home ? Array.from(home.querySelectorAll<HTMLAnchorElement>("[data-tool-card]")) : [];
  const groups = home ? Array.from(home.querySelectorAll<HTMLElement>("[data-tool-group]")) : [];
  const allGroupLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-group-link]"));
  const headerSearchBtn = document.querySelector<HTMLButtonElement>("[data-header-search]");
  const availableLabel = { available: home?.querySelector(".result-count")?.textContent?.replace(/^\d+\s*/, "") || "" };
  const resultLabel = home?.getAttribute("data-result-label") || "";

  // Hydrate Recent Tools Dock from localStorage ("zktool.recents")
  try {
    const raw = JSON.parse(localStorage.getItem("zktool.recents") || "[]");
    if (Array.isArray(raw) && raw.length && dockItems && dockBar) {
      const matched = raw
        .map((path) => cards.find((card) => card.getAttribute("data-tool-path") === path))
        .filter((card): card is HTMLAnchorElement => Boolean(card))
        .slice(0, 6);
      if (matched.length) {
        dockBar.hidden = false;
        matched.forEach((card) => {
          const pill = document.createElement("a");
          pill.className = "dock-pill";
          pill.href = card.href;
          const dot = document.createElement("span");
          dot.className = "dock-dot";
          dot.setAttribute("aria-hidden", "true");
          dot.style.setProperty("--c", card.getAttribute("data-tool-color") || "#0066ff");
          const label = document.createElement("span");
          label.textContent = card.getAttribute("data-tool-name") || "";
          pill.appendChild(dot);
          pill.appendChild(label);
          dockItems.appendChild(pill);
        });
      }
    }
  } catch { /* ignore private browsing storage errors */ }

  function filterTools() {
    const query = search?.value.trim().toLowerCase() || "";
    const terms: string[] = query.split(/\s+/).filter(Boolean);
    home?.classList.toggle("is-searching", !!query);
    let visible = 0;
    cards.forEach((card) => {
      const haystack = card.getAttribute("data-search") || "";
      const matches = terms.every((term) => haystack.includes(term));
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    groups.forEach((group) => {
      group.hidden = !group.querySelector("[data-tool-card]:not([hidden])");
      const badge = group.querySelector(".group-count");
      if (badge) badge.textContent = String(group.querySelectorAll("[data-tool-card]:not([hidden])").length).padStart(2, "0");
      allGroupLinks.forEach((link) => {
        if (link.getAttribute("data-group-link") === group.id) link.hidden = group.hidden;
      });
    });
    if (count) count.textContent = query ? `${visible} ${resultLabel}` : `${cards.length} ${availableLabel.available}`;
    if (empty) empty.hidden = visible > 0;
    if (clear) clear.hidden = !query;
    if (kbd) kbd.hidden = !!query;
    syncActiveCategory();
  }

  // 滚动联动高亮顶栏与移动端分类胶囊 (Scrollspy)
  let spyTicking = false;
  function syncActiveCategory() {
    const visibleGroups = groups.filter((g) => !g.hidden);
    if (!visibleGroups.length || window.scrollY < 140) {
      allGroupLinks.forEach((link) => link.classList.remove("is-active"));
      return;
    }
    let currentId = visibleGroups[0].id;
    const threshold = 135;
    for (const group of visibleGroups) {
      if (group.getBoundingClientRect().top <= threshold) currentId = group.id;
      else break;
    }
    // 滚动到页面最底部时高亮最后一个可见分组
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 24) {
      currentId = visibleGroups[visibleGroups.length - 1].id;
    }
    allGroupLinks.forEach((link) => {
      const active = link.getAttribute("data-group-link") === currentId;
      link.classList.toggle("is-active", active);
      if (active && link.parentElement?.classList.contains("header-groups")) {
        link.scrollIntoView({ block: "nearest", inline: "nearest" });
      }
    });
  }

  window.addEventListener("scroll", () => {
    if (!spyTicking) {
      spyTicking = true;
      requestAnimationFrame(() => {
        spyTicking = false;
        syncActiveCategory();
      });
    }
  }, { passive: true });

  headerSearchBtn?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
    setTimeout(() => search?.focus({ preventScroll: true }), 180);
  });

  search?.addEventListener("input", filterTools);
  search?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowDown" || (event.key === "Enter" && search.value.trim())) {
      const first = cards.find((card) => !card.hidden);
      if (first) { event.preventDefault(); first.focus(); }
    }
    if (event.key === "Escape") { search.value = ""; filterTools(); }
  });
  home?.querySelector(".tool-collection")?.addEventListener("keydown", (rawEvent) => {
    const event = rawEvent as KeyboardEvent;
    const visible = cards.filter((card) => !card.hidden);
    const index = visible.indexOf(document.activeElement as HTMLAnchorElement);
    if (index < 0) return;
    if (event.key === "Escape" || (event.key === "ArrowUp" && index === 0)) {
      event.preventDefault(); search?.focus();
    } else if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      event.preventDefault(); visible[index + (event.key === "ArrowDown" ? 1 : -1)]?.focus();
    }
  });
  clear?.addEventListener("click", () => { if (search) { search.value = ""; search.focus(); filterTools(); } });
  window.addEventListener("keydown", (event) => {
    const target = event.target as HTMLElement | null;
    const typing = target?.tagName === "INPUT" || target?.tagName === "TEXTAREA" || target?.isContentEditable;
    if ((event.key === "/" && !typing) || ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k")) {
      event.preventDefault();
      search?.focus();
    }
  });
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .home {
    width: min(1220px, calc(100% - 2rem));
    margin: 0.65rem auto 4rem;
    color: var(--text);
  }
  .home-hero {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 24px;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .hero-mesh {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 55% 65% at 88% -10%, rgba(0, 102, 255, 0.1), transparent 62%),
      radial-gradient(ellipse 45% 55% at 10% 110%, rgba(14, 165, 233, 0.08), transparent 60%);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    padding: clamp(1.6rem, 3.5vw, 2.6rem) clamp(1.35rem, 3.5vw, 2.75rem);
  }
  .hero-topline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.15rem;
  }
  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    padding: 0.32rem 0.78rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--text-2);
    font-size: 0.76rem;
    font-weight: 600;
  }
  .status-dot {
    width: 0.46rem;
    height: 0.46rem;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 18%, transparent);
  }
  .hero-count {
    color: var(--text-3);
    font-size: 0.78rem;
  }
  .hero-count strong {
    color: var(--text);
    font-weight: 700;
  }
  h1 {
    max-width: 44rem;
    margin: 0;
    color: var(--text);
    font-size: clamp(2.1rem, 4.4vw, 3.35rem);
    font-weight: 760;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
  .title-tail {
    color: var(--brand);
    white-space: nowrap;
  }
  .hero-intro {
    max-width: 38rem;
    margin: 0.85rem 0 1.5rem;
    color: var(--text-2);
    font-size: 0.96rem;
    line-height: 1.68;
  }
  .search-shell {
    max-width: 46rem;
    padding: 0.38rem;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--bg-soft);
  }
  .search-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-wrap input {
    width: 100%;
    height: 3.2rem;
    padding: 0 3.2rem 0 2.95rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    outline: none;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.94rem;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .search-wrap input:focus {
    border-color: var(--brand-ring);
    box-shadow: 0 0 0 3.5px var(--brand-ring-soft);
  }
  .search-wrap input::placeholder { color: var(--text-3); }
  .search-wrap input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; display: none; }
  .search-icon {
    position: absolute;
    left: 1rem;
    z-index: 1;
    display: grid;
    color: var(--text-3);
    pointer-events: none;
  }
  .search-icon svg, .search-clear svg { width: 1.05rem; height: 1.05rem; }
  .search-kbd {
    position: absolute;
    right: 0.85rem;
    padding: 0.16rem 0.48rem;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: var(--bg-soft);
    color: var(--text-3);
    font-family: var(--mono);
    font-size: 0.74rem;
    line-height: 1.2;
    pointer-events: none;
  }
  .search-clear {
    position: absolute;
    right: 0.65rem;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
  }
  .search-clear:hover, .search-clear:focus-visible {
    color: var(--text);
    background: var(--surface-2);
    outline: none;
  }

  /* 常见任务静态输出；最近使用仅在有本地记录时显示。 */
  .is-searching .dock-bar { display: none; }
  .task-link { min-height: 2.25rem; }
  .task-link span { color: var(--brand); }
  .dock-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.05rem;
  }
  .dock-label {
    color: var(--text-3);
    font-size: 0.76rem;
    font-weight: 650;
    margin-right: 0.15rem;
  }
  .dock-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  :global(.dock-pill) {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    padding: 0.32rem 0.72rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--text);
    font-size: 0.78rem;
    font-weight: 560;
    text-decoration: none;
    transition: border-color 0.18s var(--ease), background 0.18s var(--ease), transform 0.18s var(--ease), box-shadow 0.18s var(--ease);
  }
  :global(.dock-pill:hover), :global(.dock-pill:focus-visible) {
    border-color: var(--border-hover);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
    outline: none;
  }
  :global(.dock-dot) {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--c, var(--brand));
  }

  /* ── 分段胶囊分类导航（桌面端已融合进顶栏，仅在 <=1020px 窄屏显示）── */
  .mobile-group-nav {
    display: none;
    gap: 0.28rem;
    overflow-x: auto;
    margin-top: 1.05rem;
    padding: 0.36rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--glass);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
    box-shadow: var(--shadow-sm);
    scrollbar-width: none;
  }
  .mobile-group-nav::-webkit-scrollbar { display: none; }
  .mobile-group-nav a {
    flex: 0 0 auto;
    padding: 0.46rem 0.85rem;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--text-2);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.18s var(--ease), background 0.18s var(--ease), box-shadow 0.18s var(--ease), border-color 0.18s var(--ease);
  }
  .mobile-group-nav a:hover, .mobile-group-nav a:focus-visible, .mobile-group-nav a.is-active {
    border-color: var(--border);
    background: var(--surface);
    color: var(--brand);
    box-shadow: var(--shadow-sm);
    outline: none;
  }
  @media (max-width: 1020px) {
    .mobile-group-nav { display: flex; }
  }

  .collection-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.65rem 0.15rem 0.1rem;
  }
  .collection-head h2 {
    margin: 0;
    color: var(--text);
    font-size: 1.2rem;
    font-weight: 740;
    letter-spacing: -0.015em;
  }
  .result-count {
    padding: 0.28rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-2);
    font-size: 0.74rem;
    font-weight: 600;
    box-shadow: var(--shadow-sm);
  }

  .tool-group {
    margin-top: 1.5rem;
    scroll-margin-top: 5.2rem;
  }
  .group-heading {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
    padding: 0 0.15rem;
  }
  .group-heading h3 {
    margin: 0;
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 720;
    letter-spacing: -0.01em;
  }
  .group-count {
    padding: 0.12rem 0.48rem;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text-3);
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 650;
  }

  /* ── 18px Craft Bento 工具卡片 ── */
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .tool-card {
    display: grid;
    grid-template-columns: 2.65rem minmax(0, 1fr);
    gap: 0.85rem;
    min-width: 0;

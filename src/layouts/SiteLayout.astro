---
import { groups, localizedGroup, localizedTool, tools } from "../data/catalog";
import DevCacheReset from "../components/DevCacheReset.astro";

interface Props {
    title: string;
    description: string;
    locale: "zh-CN" | "en";
    path: string;
    noindex?: boolean;
}

const { title, description, locale, path, noindex = false } = Astro.props;
const origin = "https://tools.zktww.cn";
const localToolEntries = tools.filter((tool) => tool.type === "tool");
const localTools = localToolEntries.length;
const externalTools = tools.filter((tool) => tool.type === "external").length;
const alternate = locale === "en" ? (path.replace(/^\/en/, "") || "/") : (path === "/" ? "/en/" : `/en${path}`);
const isHome = path === "/" || path === "/en/";
const navGroups = isHome
    ? groups
        .filter((group) => tools.some((tool) => (tool.type === "tool" || tool.type === "external") && tool.group === group.key))
        .map((group) => localizedGroup(group, locale))
    : [];
const homeHref = locale === "en" ? "/en/" : "/";
const siteJsonLd = isHome
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "WebSite",
                name: "zktool",
                url: `${origin}${homeHref}`,
                inLanguage: locale,
                description
            },
            {
                "@type": "ItemList",
                name: locale === "en" ? "zktool Developer Tools" : "zktool 在线开发者工具集",
                numberOfItems: localTools,
                itemListElement: localToolEntries.map((source, index) => {
                    const loc = localizedTool(source, locale);
                    return {
                        "@type": "ListItem",
                        position: index + 1,
                        name: loc.name,
                        url: `${origin}${homeHref}${source.path}`
                    };
                })
            }
        ]
    })
    : null;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <DevCacheReset />
    <meta name="google-site-verification" content="8a07Jc9svEOEYoohcRj644GSddCeBBikeKA0P9EmEXk" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="stylesheet" href="/assets/tokens.css" />
    <script is:inline src="/assets/theme.js"></script>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link rel="manifest" href={locale === "en" ? "/en/manifest.webmanifest" : "/manifest.webmanifest"} />
    {!noindex && (
      <>
        <link rel="canonical" href={origin + path} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="zktool" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={origin + path} />
        <meta property="og:image" content={`${origin}/assets/og-card.jpg`} />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="alternate" hreflang="zh-CN" href={origin + (locale === "en" ? alternate : path)} />
        <link rel="alternate" hreflang="en" href={origin + (locale === "en" ? path : alternate)} />
        <link rel="alternate" hreflang="x-default" href={origin + (locale === "en" ? alternate : path)} />
      </>
    )}
    {siteJsonLd && <script is:inline type="application/ld+json" set:html={siteJsonLd} />}
  </head>
  <body>
    <div class="site-ambient" aria-hidden="true"></div>
    <div class="site-header-shell">
      <header class="site-header">
        <a class="site-brand" href={locale === "en" ? "/en/" : "/"}>
          <span class="brand-mark" aria-hidden="true">Z</span>
          <span class="brand-name">zktool</span>
        </a>
        {isHome && (
          <nav class="header-groups" data-header-groups aria-label={locale === "en" ? "Tool categories" : "工具分类"}>
            {navGroups.map((group) => (
              <a href={`#group-${group.key}`} data-group-link={`group-${group.key}`}>{group.title}</a>
            ))}
          </nav>
        )}
        <nav class="zk-actions" aria-label={locale === "en" ? "Site settings" : "站点设置"}>
          {isHome && (
            <button
              type="button"
              class="zk-icon-btn header-search-btn"
              data-header-search
              title={locale === "en" ? "Search tools (/)" : "搜索工具 (/)"}
              aria-label={locale === "en" ? "Search tools" : "搜索工具"}
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
            </button>
          )}
          <a class="zk-lang-link" href={alternate} lang={locale === "en" ? "zh-CN" : "en"}>{locale === "en" ? "中文" : "EN"}</a>
        </nav>
      </header>
    </div>
    <slot />
    <footer class="site-footer">
      <div class="footer-card">
        <div class="footer-main">
          <span>{locale === "en" ? `${localTools} local tools · ${externalTools} external service` : `${localTools} 个本地工具 · ${externalTools} 个外部服务`}</span>
          <span class="footer-dot" aria-hidden="true">·</span>
          <a href="https://github.com/zktww/zktool/issues" target="_blank" rel="noopener noreferrer">{locale === "en" ? "Feedback on GitHub" : "GitHub 问题反馈"}</a>
        </div>
        <details>
          <summary>{locale === "en" ? "Privacy & local storage" : "隐私与本地存储说明"}</summary>
          <p>{locale === "en" ? "Tool inputs are processed locally. Some tools save drafts in this browser. Sensitive tools require opt-in; shared links may contain your input. Production tool pages use Baidu Analytics for visit statistics. External services have their own policies." : "工具输入在浏览器本地处理。部分工具会保存本地草稿，敏感工具需主动开启；分享链接可能包含输入内容。线上工具页使用百度统计记录访问情况，外部服务适用其自身隐私规则。"}</p>
        </details>
      </div>
    </footer>
    <script is:inline>
      if ("serviceWorker" in navigator && location.protocol === "https:") {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js", { updateViaCache: "none" }).catch(() => {});
        }, { once: true });
      }
    </script>
  </body>
</html>

<style is:global>
:root { font-family: var(--font); background: var(--bg); color: var(--text); -webkit-font-smoothing: antialiased; }
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body { margin: 0; min-width: 320px; position: relative; overflow-x: hidden; }
.site-ambient {
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background:
    radial-gradient(ellipse 58% 42% at 16% -6%, var(--brand-soft), transparent 65%),
    radial-gradient(ellipse 46% 36% at 86% 2%, rgba(14, 165, 233, 0.08), transparent 60%),
    radial-gradient(ellipse 50% 36% at 50% 106%, rgba(16, 185, 129, 0.05), transparent 65%),
    var(--bg);
}
/* 顶部防透字渐隐遮罩层：吸顶在 top:0，让滚动内容平滑隐入毛玻璃胶囊下方 */
.site-header-shell {
  position: sticky;
  top: 0;
  z-index: 90;
  padding: 0.75rem 0 0.35rem;
  background: linear-gradient(
    to bottom,
    var(--bg) 52%,
    color-mix(in srgb, var(--bg) 76%, transparent) 82%,
    transparent
  );
  pointer-events: none;
}
.site-header {
  pointer-events: auto;
  width: min(1220px, calc(100% - 2rem));
  margin: 0 auto;
  padding: 0.38rem 0.5rem 0.38rem 0.8rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--glass);
  -webkit-backdrop-filter: saturate(180%) blur(18px);
  backdrop-filter: saturate(180%) blur(18px);
  box-shadow: var(--shadow-sm);
}
.site-brand {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 0.52rem;
  color: var(--text);
  font-size: 0.96rem;
  font-weight: 750;
  letter-spacing: -0.01em;
  text-decoration: none;
}
.brand-mark {
  display: grid;
  width: 1.7rem;
  height: 1.7rem;
  place-items: center;
  border-radius: 8px;
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  color: #fff;
  font-size: 0.8rem;
  font-weight: 800;
  line-height: 1;
  box-shadow: 0 3px 10px -2px rgba(0, 102, 255, 0.38);
}
/* 顶栏居中分类胶囊导航 */
.header-groups {
  flex: 0 1 auto;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 0.16rem;
  overflow-x: auto;
  padding: 0.18rem;
  border-radius: 999px;
  scrollbar-width: none;
}
.header-groups::-webkit-scrollbar { display: none; }
.header-groups a {
  flex: 0 0 auto;
  padding: 0.38rem 0.72rem;
  border: 1px solid transparent;
  border-radius: 999px;
  color: var(--text-2);
  font-size: 0.78rem;
  font-weight: 600;
  line-height: 1.2;
  white-space: nowrap;
  text-decoration: none;
  transition: color 0.18s var(--ease), background 0.18s var(--ease), border-color 0.18s var(--ease), box-shadow 0.18s var(--ease);
}
.header-groups a:hover,
.header-groups a:focus-visible {
  color: var(--text);
  background: var(--surface-hover);
  outline: none;
}
.header-groups a.is-active {
  color: var(--brand);
  border-color: var(--border);
  background: var(--surface);
  box-shadow: var(--shadow-sm);
}
.site-header .zk-actions { flex: 0 0 auto; }
.site-footer {
  width: min(1220px, calc(100% - 2rem));
  margin: 2.5rem auto 2.2rem;
}
.footer-card {
  padding: 1.1rem 1.35rem;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--surface);
  box-shadow: var(--shadow-sm);
  color: var(--text-2);
  font-size: 0.84rem;
}
.footer-main {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.55rem;
}
.footer-dot { color: var(--text-3); }
.site-footer a { color: var(--brand); font-weight: 600; text-decoration: none; }
.site-footer a:hover { text-decoration: underline; }
.site-footer details { margin-top: 0.55rem; }
.site-footer summary { color: var(--text-3); font-size: 0.8rem; cursor: pointer; user-select: none; }
.site-footer p { max-width: 52rem; margin: 0.45rem 0 0; color: var(--text-2); font-size: 0.8rem; line-height: 1.65; }
@media (max-width: 1020px) {
  .header-groups { display: none; }
}
@media (max-width: 560px) {
  .site-header-shell { padding-top: 0.5rem; }
  .site-header { width: calc(100% - 1.25rem); }
  .site-footer { width: calc(100% - 1.25rem); }
}
</style>

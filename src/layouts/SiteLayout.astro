---
import { tools } from "../data/catalog";
import DevCacheReset from "../components/DevCacheReset.astro";

interface Props {
    title: string;
    description: string;
    locale: "zh-CN" | "en";
    path: string;
}

const { title, description, locale, path } = Astro.props;
const origin = "https://tools.zktww.cn";
const localTools = tools.filter((tool) => tool.type === "tool").length;
const externalTools = tools.filter((tool) => tool.type === "external").length;
const alternate = locale === "en" ? (path.replace(/^\/en/, "") || "/") : (path === "/" ? "/en/" : `/en${path}`);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <DevCacheReset />
    <meta name="google-site-verification" content="8a07Jc9svEOEYoohcRj644GSddCeBBikeKA0P9EmEXk" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="stylesheet" href="/assets/tokens.css" />
    <script is:inline src="/assets/theme.js"></script>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="manifest" href={locale === "en" ? "/en/manifest.webmanifest" : "/manifest.webmanifest"} />
    <link rel="canonical" href={origin + path} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={origin + path} />
    <link rel="alternate" hreflang="zh-CN" href={origin + (locale === "en" ? alternate : path)} />
    <link rel="alternate" hreflang="en" href={origin + (locale === "en" ? path : alternate)} />
    <link rel="alternate" hreflang="x-default" href={origin + (locale === "en" ? alternate : path)} />
  </head>
  <body>
    <header class="site-header">
      <a class="site-brand" href={locale === "en" ? "/en/" : "/"}><span class="brand-mark" aria-hidden="true">Z</span><span>zktool</span></a>
      <nav class="zk-actions" aria-label={locale === "en" ? "Site settings" : "站点设置"}>
        <a class="zk-lang-link" href={alternate} lang={locale === "en" ? "zh-CN" : "en"}>{locale === "en" ? "中文" : "EN"}</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <span>{locale === "en" ? `${localTools} local tools · ${externalTools} external service` : `${localTools} 个本地工具 · ${externalTools} 个外部服务`}</span>
      <a href="https://github.com/zktww/zktool/issues" target="_blank" rel="noopener noreferrer">{locale === "en" ? "Feedback" : "问题反馈"}</a>
      <details><summary>{locale === "en" ? "Privacy & storage" : "隐私与本地存储"}</summary><p>{locale === "en" ? "Tool inputs are processed locally. Some tools save drafts in this browser. Sensitive tools require opt-in; shared links may contain your input. Production tool pages use Baidu Analytics for visit statistics. External services have their own policies." : "工具输入在浏览器本地处理。部分工具会保存本地草稿，敏感工具需主动开启；分享链接可能包含输入内容。线上工具页使用百度统计记录访问情况，外部服务适用其自身隐私规则。"}</p></details>
    </footer>
    <script is:inline>
      if ("serviceWorker" in navigator && location.protocol === "https:") {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js", { updateViaCache: "none" }).catch(() => {});
        }, { once: true });
      }
    </script>
  </body>
</html>

<style is:global>
:root { font-family: var(--font); background: var(--bg); color: var(--text); }
* { box-sizing: border-box; }
body { margin: 0; min-width: 320px; }
.site-header { position: relative; width: min(1180px, calc(100% - 2.5rem)); margin: 0 auto; min-height: 4.4rem; display: flex; align-items: center; justify-content: space-between; }
.site-header::after { content: ""; position: absolute; right: 0; bottom: 0; left: 0; height: 1px; background: var(--border); }
.site-brand { display: inline-flex; align-items: center; gap: .55rem; color: var(--text); font-size: 1rem; font-weight: 760; letter-spacing: 0; text-decoration: none; }
.site-footer { display: flex; flex-wrap: wrap; gap: 1rem; width: min(1180px, calc(100% - 2.5rem)); margin: 2rem auto; padding-top: 1.5rem; border-top: 1px solid var(--border); color: var(--text-2); font-size: .85rem; }
.site-footer a, .site-footer summary { color: var(--text-2); cursor: pointer; }
.site-footer p { max-width: 42rem; line-height: 1.7; }
.brand-mark { display: grid; width: 1.45rem; height: 1.45rem; place-items: center; border-radius: 4px; background: #2563eb; color: #fff; font-size: .72rem; font-weight: 800; line-height: 1; }
@media (max-width: 520px) { .site-header { width: min(100% - 1.25rem, 42rem); min-height: 4rem; } }
</style>

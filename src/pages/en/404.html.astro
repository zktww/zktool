---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="Page not found | zktool" description="The requested page could not be found." locale="en" path="/en/404.html">
  <main class="not-found">
    <p>404</p>
    <h1>Page not found</h1>
    <a href="/en/">Browse tools</a>
  </main>
</SiteLayout>

<style>
.not-found { width: min(760px, calc(100% - 2rem)); margin: 12vh auto; }
.not-found p { margin: 0; color: #6d28d9; font-size: 1rem; font-weight: 700; }
.not-found h1 { margin: .5rem 0 1.5rem; font-size: clamp(2rem, 7vw, 4rem); }
.not-found a { color: #6d28d9; font-weight: 650; }
</style>
